# Front controller routing for Apache (mod_rewrite must be enabled).
Options -Indexes -MultiViews

# Never serve PHP configuration files.
<Files ".user.ini">
    Require all denied
</Files>
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Canonical host: http:// and www. -> https://floorplandesigner.app
    # /.well-known/ is excluded: Android App Links verification does not follow
    # redirects, so assetlinks.json must answer 200 on every host it checks.
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

    RewriteCond %{REQUEST_URI} !^/\.well-known/
    # Several HTTPS signals are checked because on cPanel Nginx often terminates
    # TLS in front of Apache; checking only %{HTTPS} could cause a redirect loop.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{ENV:HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteCond %{SERVER_PORT} !=443
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # Serve real files and folders directly (assets, api/v1/*.php, admin/*.php)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else goes to the front controller
    RewriteRule ^ index.php [QSA,L]
</IfModule>

<Files "assetlinks.json">
    ForceType application/json
</Files>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|png|jpe?g|gif|svg|ico|webp|woff2?)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>
